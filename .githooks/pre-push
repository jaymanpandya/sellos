#!/usr/bin/env bash
# Blocks a push that contains a commit whose content never passed the gate on this machine.
set -euo pipefail
REPO="$(git rev-parse --show-toplevel)"
LOG="$REPO/.git/sellos_gate_log"
ZERO="0000000000000000000000000000000000000000"

if [ -n "${SELLOS_SKIP_GATE:-}" ]; then
	echo "SELLOS_SKIP_GATE is set: $SELLOS_SKIP_GATE" >&2
	echo "$(date +%s) skipped: $SELLOS_SKIP_GATE" >>"$REPO/.git/sellos_gate_waivers"
	exit 0
fi

BAD=0
while read -r _local_ref local_sha _remote_ref remote_sha; do
	[ "$local_sha" = "$ZERO" ] && continue
	if [ "$remote_sha" = "$ZERO" ]; then
		RANGE="$(git rev-list "$local_sha" --not --remotes)"
	else
		RANGE="$(git rev-list "$remote_sha..$local_sha")"
	fi
	for commit in $RANGE; do
		parents=$(git rev-list --parents -n 1 "$commit" | wc -w)
		[ "$parents" -gt 2 ] && continue # merge commits are not gated
		tree="$(git rev-parse "$commit^{tree}")"
		if ! grep -q "^$tree " "$LOG" 2>/dev/null; then
			echo "Commit $(git rev-parse --short "$commit") never passed the gate on this machine." >&2
			BAD=1
		fi
	done
done

if [ "$BAD" -ne 0 ]; then
	echo "Run scripts/test_all.sh on that content, then push again." >&2
	exit 1
fi
