# The Semgrep version and Frappe rules commit that the gate and CI both use (SOS-SETUP-33).
# scripts/make-baseline.sh installs them, scripts/check-guards.sh --all refuses others (exit 3), and
# the Linters workflow installs them. Change both values here, in one commit, to move both together.
SEMGREP_VERSION=1.183.0
SEMGREP_RULES_SHA=81a6e3d47a328249e8ddf04c586e493dd5553002
